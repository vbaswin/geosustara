# Normalise line endings so the repo is identical regardless of the OS it was
# committed from. Checked-in files use LF; Windows working copies still get CRLF
# for the formats that expect it.
* text=auto eol=lf

*.njk      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.md       text eol=lf
*.html     text eol=lf
*.svg      text eol=lf
*.xml      text eol=lf
*.txt      text eol=lf

# Binary — never touch these
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.avif     binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.docx     binary
