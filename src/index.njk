---
layout: layouts/base.njk
title: false
description: "Environmental and geospatial consultants in Thiruvananthapuram, Kerala — EIA and Environmental Clearance support, GIS mapping, water and wastewater solutions."
---
{%- from "partials/icons.njk" import svcIcon, arrow, picture -%}

<div class="hero">
  <div class="hero-bg">
    {#- Capped at 1440w on purpose: this sits under a dark scrim with a sub-pixel blur baked in,
        so a 1920 variant is visually identical but 70% heavier on the LCP element. -#}
    <picture>
      <source type="image/avif" srcset="{{ '/assets/img/hero-960.avif' | url }} 960w, {{ '/assets/img/hero-1440.avif' | url }} 1440w" sizes="100vw">
      <source type="image/webp" srcset="{{ '/assets/img/hero-960.webp' | url }} 960w, {{ '/assets/img/hero-1440.webp' | url }} 1440w" sizes="100vw">
      <img src="{{ '/assets/img/hero-1440.jpg' | url }}" width="1440" height="810" fetchpriority="high" decoding="async"
           alt="False-colour satellite image of a river delta showing braided channel networks and land-cover zones.">
    </picture>
  </div>
  <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <svg class="hero-mesh" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true"><g id="mesh"></g></svg>

  <div class="wrap hero-in">
    <div class="eyebrow">
      <span class="rule"></span>
      <span class="label">{{ site.strapline }} &middot; {{ site.contact.locality }}</span>
    </div>
    {#- The H1 carries the two terms this firm has to rank for, and closes on the promise
        printed on its own brochure. Three lines of roughly equal length so none of them
        wraps inside the clipped .ln mask. -#}
    <h1 class="hh">
      <span class="ln"><span>Environmental and</span></span>
      <span class="ln"><span><em>geospatial</em> consulting</span></span>
      <span class="ln"><span>backed by evidence.</span></span>
    </h1>
    <div class="hero-row">
      <div>
        <p class="hero-p">Environmental Impact Assessment and clearance support, GIS and remote sensing,
          water and wastewater engineering — from field investigation through to a commissioned system.</p>
        <div class="hero-cta">
          <a class="btn mag" href="{{ '/services/' | url }}">View our services {{ arrow() }}</a>
          <a class="btn btn--out mag" href="https://wa.me/{{ site.contact.whatsapp }}" rel="noopener">
            {{ svcIcon("chat") }} WhatsApp us</a>
        </div>
      </div>
      <div class="metrics">
        <div class="metric"><span class="n" data-count="{{ services.length }}">0</span><span class="t">Service<br>areas</span></div>
        <div class="metric"><span class="n" data-count="{{ site.sectors.length }}">0</span><span class="t">Sectors<br>served</span></div>
        <div class="metric"><span class="n" data-count="{{ site.lifecycle.length }}">0</span><span class="t">Stage<br>lifecycle</span></div>
      </div>
    </div>
  </div>
  <div class="scrollcue" aria-hidden="true"><span>Scroll</span><i></i></div>
</div>

<div class="ticker">
  <div class="tk">
    <div class="tk-set">
      {%- for s in site.sectors %}<span>{{ s }}</span><i></i>{% endfor %}
    </div>
    <div class="tk-set" aria-hidden="true">
      {%- for s in site.sectors %}<span>{{ s }}</span><i></i>{% endfor %}
    </div>
  </div>
</div>

<!-- ===================== WHY US ===================== -->
<section class="sec" id="why-us">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="label">01 — Why us</span>
      {#- The brochure's three-sentence motto, broken one sentence to a line. Kept as a single
          string in site.json so there is one place to correct the wording. -#}
      <h2 class="sec-title">{{ site.motto | replace(". ", ".<br>") | safe }}</h2>
    </div>
    <div class="why">
      <div class="rv">
        <p class="why-lead">{{ site.whyUs.problem }}</p>
        <p class="why-body">{{ site.whyUs.answer }}</p>
      </div>
      <ul class="pillars rv">
        {%- for p in site.whyUs.pillars %}
        <li>
          <h3>{{ p.t }}</h3>
          <p>{{ p.d }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<!-- ===================== SERVICES ===================== -->
<section class="sec sec--tint" id="services">
  <div class="topo-band" aria-hidden="true">
    <svg viewBox="0 0 1440 180" preserveAspectRatio="none"><g data-topo-band fill="none" stroke="#16C264" stroke-width="1"></g></svg>
  </div>
  <div class="wrap">
    <div class="sec-head rv">
      <span class="label">02 — What we do</span>
      <h2 class="sec-title">Six disciplines,<br>one integrated practice.</h2>
      <p class="sec-lede">Environmental compliance and auditing, Environmental Impact Assessment and clearance
        support, GIS and remote sensing, water, wastewater and solid waste engineering, sustainability
        consulting, and training and research support — from one team, on one set of site data.</p>
    </div>

    {#- Overview only. The capability lists live on /services/ and each detail page, so the
        same content is not competing with itself across three URLs. -#}
    <div class="bento">
      {%- for s in services %}
      <article class="bx {{ 'bx--wide' if loop.index <= 2 }} rv" style="min-height:0">
        <span class="bx-spot"></span><span class="bx-topo" data-topo></span>
        <span class="bx-no">{{ s.n }}</span>
        <span class="bx-ico">{{ svcIcon(s.icon, true) }}</span>
        <h3>{{ s.title }}</h3>
        <p>{{ s.summary }}</p>
        <span class="more">Explore {{ arrow() }}</span>
        <a class="bx-link" href="{{ ('/services/' + s.slug + '/') | url }}"><span class="vh">{{ s.title }}</span></a>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ===================== EXPERTISE ===================== -->
{#- The capability list from the brochure. Each entry links to the page that covers it, so
    this doubles as the internal-linking spine of the site. -#}
<section class="sec" id="expertise">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="label">03 — Our expertise</span>
      <h2 class="sec-title">What we are asked<br>for most often.</h2>
      <p class="sec-lede">The capabilities behind the six service areas. Each one links to where it is
        covered in full.</p>
    </div>
    <ul class="xp rv">
      {%- for e in site.expertise %}
      <li>
        <a href="{{ ('/services/' + e.s + '/') | url }}">
          <span class="d" aria-hidden="true"></span>{{ e.t }}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<!-- ===================== LIFECYCLE ===================== -->
<section class="sec sec--tint" id="approach">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="label">04 — How we work</span>
      <h2 class="sec-title">From first survey to<br>continuous monitoring.</h2>
      <p class="sec-lede">We support our clients from initial assessment and planning through implementation and
        continuous monitoring — transforming environmental challenges into opportunities for responsible growth
        and innovation.</p>
    </div>
    {#- Compact strip here; the full scroll-tracked panel version lives on /about/#approach. -#}
    <ol class="stages">
      {%- for st in site.lifecycle %}
      <li class="stage rv">
        <span class="stage-n">{{ st.n }}</span>
        <h3>{{ st.title }}</h3>
        <p>{{ st.short }}</p>
      </li>
      {%- endfor %}
    </ol>
    <div class="hero-cta rv" style="margin-top:clamp(28px,4vh,44px)">
      <a class="btn btn--out mag" href="{{ '/about/' | url }}#approach">How we work, in full {{ arrow() }}</a>
    </div>
  </div>
</section>

<!-- ===================== PURPOSE ===================== -->
{#- The Vision and Mission statements in full belong to /about/. Here they are represented by
    the belief they rest on, so the two pages are not competing for the same words. -#}
<section class="sec" id="purpose">
  <div class="wrap">
    <div class="sec-head rv" style="text-align:center;margin-inline:auto">
      <span class="label">05 — Our purpose</span>
    </div>
    <p class="pullquote rv">We bridge environmental responsibility with <em>practical implementation</em>.</p>
    <p class="rv" style="text-align:center;max-width:56ch;margin:26px auto 0;color:var(--muted);font-size:clamp(15px,.45vw + 14px,17.5px);line-height:1.74">
      {{ site.promise }} We support clients from first assessment through to continuous
      monitoring rather than handing over a report and leaving.
    </p>
  </div>
</section>

<!-- ===================== INSIGHTS ===================== -->
{%- set latest = collections.insights | reverse | limit(3) %}
{%- if latest.length %}
<section class="sec sec--tint" id="insights">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="label">06 — Insights</span>
      <h2 class="sec-title">Notes from the field.</h2>
      <p class="sec-lede">On regulation, geospatial method and environmental performance — written for the people
        who have to act on them.</p>
    </div>
    <div class="posts">
      {%- for p in latest %}
      <a class="post rv" href="{{ p.url | url }}">
        <div class="thumb">
          {{ picture(p.data.image or "card-gis", p.data.imageAlt or "", [520,900],
                     "(max-width:760px) 92vw, 30vw", "lazy", false, 900, 563) }}
        </div>
        <div class="body">
          <span class="k">{{ p.data.category }}</span>
          <h3>{{ p.data.title }}</h3>
          <p>{{ p.data.description }}</p>
          <span class="more">Read {{ arrow() }}</span>
        </div>
      </a>
      {%- endfor %}
    </div>
    <div class="hero-cta rv" style="margin-top:clamp(28px,4vh,44px)">
      <a class="btn btn--out mag" href="{{ '/insights/' | url }}">All insights {{ arrow() }}</a>
    </div>
  </div>
</section>
{%- endif %}

<!-- ===================== CONTACT ===================== -->
{#- A short routing band, not a second copy of /contact/. The enquiry form and the map live
    on the contact page only, so a visitor never meets the same block twice. -#}
<section class="sec" id="contact">
  <div class="wrap contact-band">
    <div class="rv">
      <span class="label">07 — Contact</span>
      <h2 class="sec-title" style="max-width:16ch">Start with an assessment.</h2>
    </div>
    <div class="rv">
      <ul class="cband">
        <li><span class="ctk">Office</span><span class="ctv">{{ site.contact.addressLine }},<br>{{ site.contact.locality }} {{ site.contact.postalCode }}</span></li>
        <li><span class="ctk">Telephone</span><span class="ctv">
          {%- for p in site.contact.phones %}
          <a href="tel:{{ p.e164 }}">{{ p.display }}</a>{% if not loop.last %}<br>{% endif %}
          {%- endfor %}
        </span></li>
        <li><span class="ctk">WhatsApp</span><span class="ctv"><a href="https://wa.me/{{ site.contact.whatsapp }}" rel="noopener">Message us</a></span></li>
        <li><span class="ctk">Email</span><span class="ctv"><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></span></li>
      </ul>
      <p class="form-note" style="margin-top:18px">A map and the full enquiry form are on the
        <a href="{{ '/contact/' | url }}" style="color:var(--brand)">contact page</a>.</p>
    </div>
  </div>
</section>
