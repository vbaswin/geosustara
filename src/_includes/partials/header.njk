{#- The mark is the company's own GS monogram, keyed out of the brochure artwork and
    re-toned for a dark surface (.tooling/brand). It is a raster because the original is —
    width and height are set on the element so it never contributes layout shift. -#}
{%- macro mark(w, h, cls) -%}
<img class="{{ cls }}" src="{{ '/assets/img/mark-96.png' | url }}"
     srcset="{{ '/assets/img/mark-96.png' | url }} 96w, {{ '/assets/img/mark-192.png' | url }} 192w"
     sizes="{{ w }}px" width="{{ w }}" height="{{ h }}" alt="" aria-hidden="true" decoding="async">
{%- endmacro -%}

{%- set arrow -%}
<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
{%- endset -%}

<header class="site">
  <div class="wrap nav">
    <a class="brand" href="{{ '/' | url }}" {% if page.url == "/" %}aria-current="page"{% endif %}>
      {{ mark(46, 39, "brand-mark") }}
      <span>
        <span class="brand-name">GEOSUSTARA</span>
        <span class="brand-sub">ENVIRO SERVICES LLP</span>
      </span>
      <span class="vh">{{ site.name }} — home</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {%- for item in site.nav %}
      <a href="{{ item.url | url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.text }}</a>
      {%- endfor %}
    </nav>

    <a class="btn mag" href="{{ '/contact/' | url }}">Request a consultation {{ arrow | safe }}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span>
    </button>
  </div>
</header>

<nav class="mnav" id="mobile-nav" data-open="false" aria-label="Mobile">
  {%- for item in site.nav %}
  <a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
    {{ item.text }} {{ arrow | safe }}
  </a>
  {%- endfor %}
  {#- No CTA button here either: "Contact" is already in the list above, one tap away. -#}
  <div class="mnav-meta">
    <span>{{ site.contact.addressLine }}, {{ site.contact.locality }} {{ site.contact.postalCode }}</span>
    {%- for p in site.contact.phones %}
    <a href="tel:{{ p.e164 }}">{{ p.display }}</a>
    {%- endfor %}
    <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
  </div>
</nav>
