{#- Structured data as a single @graph so entities can cross-reference by @id. -#}
{#- @ids are built from homeUrl, not siteUrl: siteUrl is the bare origin, and on a hosted
    sub-path (GitHub Pages project site) the prefix has to be part of the identity. -#}
{%- set orgId  = homeUrl + "#organization" -%}
{%- set siteId = homeUrl + "#website" -%}
{%- set pageId = (page.url | absUrl(siteUrl)) + "#webpage" -%}
{#- Recomputed rather than inherited from the layout: an include should not depend on which
    variables the parent happens to have set before it. -#}
{%- set pageTitle = title + " | " + site.shortName if title else site.name -%}
{%- set pageDesc  = description or site.description -%}
{%- set pageImg   = (ogImage or "/assets/img/og-default.jpg") | absUrl(siteUrl) -%}
{#- Breadcrumbs: explicit front matter wins; otherwise derive from page type. -#}
{%- set crumbs = breadcrumbs -%}
{%- if not crumbs and service -%}
  {%- set crumbs = [
    { "text": "Home", "url": "/" },
    { "text": "Services", "url": "/services/" },
    { "text": service.title }
  ] -%}
{%- endif -%}
{%- if not crumbs and layout == "layouts/post.njk" -%}
  {%- set crumbs = [
    { "text": "Home", "url": "/" },
    { "text": "Insights", "url": "/insights/" },
    { "text": title }
  ] -%}
{%- endif -%}
{%- set faqList = faqs or service.faqs -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService", "LocalBusiness"],
      "@id": {{ orgId | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "alternateName": {{ site.shortName | dump | safe }},
      "slogan": {{ site.strapline | dump | safe }},
      "url": {{ homeUrl | dump | safe }},
      "description": {{ site.descriptionLong | dump | safe }},
      "email": {{ site.contact.email | dump | safe }},
      "telephone": {{ site.contact.phoneE164 | dump | safe }},
      "contactPoint": [
        {%- for p in site.contact.phones %}
        {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "telephone": {{ p.e164 | dump | safe }},
          "email": {{ site.contact.email | dump | safe }},
          "areaServed": "IN",
          "availableLanguage": ["en", "ml"]
        }{{ "," if not loop.last }}
        {%- endfor %}
      ],
      "logo": {
        "@type": "ImageObject",
        "@id": {{ (homeUrl + "#logo") | dump | safe }},
        "url": {{ ("/assets/img/logo.png" | absUrl(siteUrl)) | dump | safe }},
        "contentUrl": {{ ("/assets/img/logo.png" | absUrl(siteUrl)) | dump | safe }},
        "width": 640,
        "height": 537,
        "caption": {{ site.name | dump | safe }}
      },
      "image": { "@id": {{ (homeUrl + "#logo") | dump | safe }} },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ site.contact.addressLine | dump | safe }},
        "addressLocality": {{ site.contact.locality | dump | safe }},
        "addressRegion": {{ site.contact.region | dump | safe }},
        "postalCode": {{ site.contact.postalCode | dump | safe }},
        "addressCountry": {{ site.contact.countryCode | dump | safe }}
      },
      "areaServed": [
        { "@type": "Country", "name": {{ site.areaServed | dump | safe }} }
        {%- for r in site.areaServedRegions %},
        { "@type": "State", "name": {{ r | dump | safe }} }
        {%- endfor %}
      ],
      "knowsAbout": [
        "Environmental impact assessment",
        "Environmental clearance",
        "Environmental site investigation",
        "Environmental compliance",
        "Environmental auditing",
        "Environmental engineering",
        "Geographic information systems",
        "Remote sensing",
        "Thematic mapping",
        "Land use and land cover mapping",
        "Watershed analysis",
        "Water quality analysis",
        "Sewage treatment plant design",
        "Wastewater treatment and reactor design",
        "Solid waste management",
        "Swimming pool water treatment",
        "Pollution control",
        "Rainwater harvesting",
        "Sustainability reporting",
        "ESG reporting",
        "Green building certification",
        "CADD and technical design",
        "Environmental research and training"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Environmental and geospatial services",
        "itemListElement": [
          {%- for s in services %}
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": {{ s.title | dump | safe }},
              "description": {{ s.summary | dump | safe }},
              "url": {{ (("/services/" + s.slug + "/") | absUrl(siteUrl)) | dump | safe }}
            }
          }{{ "," if not loop.last }}
          {%- endfor %}
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": {{ siteId | dump | safe }},
      "url": {{ homeUrl | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "publisher": { "@id": {{ orgId | dump | safe }} },
      "inLanguage": {{ site.lang | dump | safe }}
    },
    {
      "@type": "WebPage",
      "@id": {{ pageId | dump | safe }},
      "url": {{ (page.url | absUrl(siteUrl)) | dump | safe }},
      "name": {{ pageTitle | dump | safe }},
      "description": {{ pageDesc | dump | safe }},
      "isPartOf": { "@id": {{ siteId | dump | safe }} },
      "about": { "@id": {{ orgId | dump | safe }} },
      "primaryImageOfPage": {{ pageImg | dump | safe }},
      "inLanguage": {{ site.lang | dump | safe }}
      {%- if crumbs %},
      "breadcrumb": { "@id": {{ ((page.url | absUrl(siteUrl)) + "#breadcrumbs") | dump | safe }} }
      {%- endif %}
    }

    {%- if crumbs %},
    {
      "@type": "BreadcrumbList",
      "@id": {{ ((page.url | absUrl(siteUrl)) + "#breadcrumbs") | dump | safe }},
      "itemListElement": [
        {%- for c in crumbs %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "name": {{ c.text | dump | safe }}
          {%- if c.url %},
          "item": {{ (c.url | absUrl(siteUrl)) | dump | safe }}
          {%- endif %}
        }{{ "," if not loop.last }}
        {%- endfor %}
      ]
    }
    {%- endif %}

    {%- if service %},
    {
      "@type": "Service",
      "@id": {{ ((page.url | absUrl(siteUrl)) + "#service") | dump | safe }},
      "name": {{ service.title | dump | safe }},
      "description": {{ service.summary | dump | safe }},
      "serviceType": {{ service.title | dump | safe }},
      "provider": { "@id": {{ orgId | dump | safe }} },
      "areaServed": [
        { "@type": "Country", "name": {{ site.areaServed | dump | safe }} }
        {%- for r in site.areaServedRegions %},
        { "@type": "State", "name": {{ r | dump | safe }} }
        {%- endfor %}
      ],
      "url": {{ (page.url | absUrl(siteUrl)) | dump | safe }},
      "mainEntityOfPage": { "@id": {{ pageId | dump | safe }} },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": {{ service.title | dump | safe }},
        "itemListElement": [
          {%- for b in service.bullets %}
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": {{ b | dump | safe }} } }{{ "," if not loop.last }}
          {%- endfor %}
        ]
      }
    }
    {%- endif %}

    {%- if faqList %},
    {
      "@type": "FAQPage",
      "@id": {{ ((page.url | absUrl(siteUrl)) + "#faq") | dump | safe }},
      "mainEntity": [
        {%- for f in faqList %}
        {
          "@type": "Question",
          "name": {{ f.q | dump | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
        }{{ "," if not loop.last }}
        {%- endfor %}
      ]
    }
    {%- endif %}

    {%- if layout == "layouts/post.njk" %},
    {
      "@type": "BlogPosting",
      "@id": {{ ((page.url | absUrl(siteUrl)) + "#article") | dump | safe }},
      "headline": {{ title | dump | safe }},
      "description": {{ (description or site.description) | dump | safe }},
      "datePublished": {{ (page.date | dateISO) | dump | safe }},
      "dateModified": {{ (page.date | dateISO) | dump | safe }},
      "author": { "@id": {{ orgId | dump | safe }} },
      "publisher": { "@id": {{ orgId | dump | safe }} },
      "mainEntityOfPage": { "@id": {{ pageId | dump | safe }} },
      "articleSection": {{ (category or "Insights") | dump | safe }},
      "inLanguage": {{ site.lang | dump | safe }}
      {%- if ogImage %},
      "image": {{ (ogImage | absUrl(siteUrl)) | dump | safe }}
      {%- endif %}
    }
    {%- endif %}
  ]
}
</script>
