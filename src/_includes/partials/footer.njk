<footer class="site">
  <div class="wrap">
    <div class="fg">
      <div class="fbrand">
        <img class="brand-mark" src="{{ '/assets/img/mark-96.png' | url }}"
             srcset="{{ '/assets/img/mark-96.png' | url }} 96w, {{ '/assets/img/mark-192.png' | url }} 192w"
             sizes="40px" width="40" height="34" alt="" aria-hidden="true" loading="lazy" decoding="async">
        <p>{{ site.name }} — environmental and geospatial consulting: EIA and Environmental Clearance
          support, GIS and remote sensing, water, wastewater and solid waste solutions, sustainability
          and research support.</p>
        <address>
          {{ site.contact.addressLine }},<br>
          {{ site.contact.locality }}, {{ site.contact.region }} {{ site.contact.postalCode }}<br>
          {%- for p in site.contact.phones %}
          <a href="tel:{{ p.e164 }}">{{ p.display }}</a><br>
          {%- endfor %}
          <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
        </address>
      </div>

      <div>
        <h2>Services</h2>
        {%- for s in services %}
        <a href="{{ ('/services/' + s.slug + '/') | url }}">{{ s.shortTitle }}</a>
        {%- endfor %}
      </div>

      <div>
        <h2>Firm</h2>
        <a href="{{ '/about/' | url }}">About</a>
        <a href="{{ '/about/' | url }}#vision">Vision &amp; Mission</a>
        <a href="{{ '/about/' | url }}#who-we-serve">Who we serve</a>
        <a href="{{ '/about/' | url }}#approach">Approach</a>
        <a href="{{ '/contact/' | url }}">Contact</a>
      </div>

      <div>
        <h2>More</h2>
        <a href="{{ '/insights/' | url }}">All articles</a>
        <a href="{{ '/insights/feed.xml' | url }}">RSS feed</a>
        <a href="{{ '/sitemap.xml' | url }}">Sitemap</a>
        <a href="{{ '/privacy/' | url }}">Privacy</a>
      </div>
    </div>

    <div class="fbot">
      <span>&copy; {{ buildYear }} {{ site.name }}</span>
      <span>{{ site.contact.locality }}, {{ site.contact.region }} &middot; {{ site.areaServed }}</span>
    </div>
    <div class="fghost" aria-hidden="true">GEOSUSTARA</div>
  </div>
</footer>
