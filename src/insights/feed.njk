---
permalink: /insights/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.shortName }} — Insights</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ "/insights/feed.xml" | absUrl(siteUrl) }}" rel="self"/>
  <link href="{{ siteUrl }}/"/>
  {%- set newest = collections.insights | reverse | first %}
  <updated>{{ (newest.date | dateISO) if newest else buildDate }}</updated>
  <id>{{ siteUrl }}/</id>
  <author>
    <name>{{ site.name }}</name>
    <email>{{ site.contact.email }}</email>
  </author>
  {%- for post in collections.insights | reverse %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absUrl(siteUrl) }}"/>
    <updated>{{ post.date | dateISO }}</updated>
    <id>{{ post.url | absUrl(siteUrl) }}</id>
    <category term="{{ post.data.category }}"/>
    <summary>{{ post.data.description }}</summary>
  </entry>
  {%- endfor %}
</feed>
