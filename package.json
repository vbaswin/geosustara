    "http-server": "14.1.1",
    "license-checker-rseidelsohn": "4.4.2",
    "luxon": "3.7.2",
    "markdown-it-anchor": "9.2.0",
    "sharp": "0.35.4"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "leaflet": "1.9.4",
    "lenis": "1.3.11"
