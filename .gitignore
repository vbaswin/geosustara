# ---- dependencies & toolchain -------------------------------------------
node_modules/

# The portable Node runtime and npm cache live inside the project so nothing
# is installed system-wide. They are ~250 MB and re-downloadable — never commit.
.tooling/node/
.tooling/npm-cache/
.tooling/npm-global/
.tooling/preview/
.tooling/*.json

# ---- build output --------------------------------------------------------
# Generated by `npm run build`. Vercel (or any host) rebuilds it from source.
_site/

# ---- source imagery ------------------------------------------------------
# Original NASA/USGS scenes, ~35 MB. The optimised derivatives in
# src/assets/img ARE committed, so a clone can build without these.
# Run `node .tooling/fetch-raw.mjs` to re-download them (public domain).
src/assets/img/raw/

# ---- design exploration --------------------------------------------------
# The three concept directions from the design phase. Kept locally as a
# reference; not part of the deliverable and full of duplicated vendor files.
concepts/

# ---- assistant / editor tooling ------------------------------------------
# Claude Code's local skill data — developer tooling, not part of the website.
.claude/

# ---- editor / OS ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# ---- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
.vercel
